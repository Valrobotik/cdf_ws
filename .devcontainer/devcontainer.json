{
    "name": "ROS 2 Development Container",
    "initializeCommand": [
        "bash",
        "-lc",
        "mkdir -p \"$HOME\" && touch \"$HOME/.Xauthority\"; u=$(id -un); if command -v xhost >/dev/null 2>&1; then xhost +si:localuser:$u >/dev/null 2>&1 || true; xhost +si:localuser:root >/dev/null 2>&1 || true; fi"
    ],
    "privileged": false,
    "remoteUser": "root",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "root"
        }
    },
    "updateRemoteUserUID": false,
    "workspaceFolder": "/home/ws",
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/ws,type=bind",
    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ms-iot.vscode-ros"
            ]
        }
    },
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "XAUTHORITY": "/tmp/.Xauthority",
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
        "ROS_DOMAIN_ID": "96"
    },
    "runArgs": [
        "--gpus", "all",
        "--cap-add=NET_RAW",
        "--net=host",
        "--pid=host",
        "--ipc=host"
    ],
    "mounts": [
       "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
       "source=/dev/dri,target=/dev/dri,type=bind,consistency=cached",
       "source=${localEnv:HOME}/.Xauthority,target=/tmp/.Xauthority,type=bind,readonly"
    ],
    "postCreateCommand": "sudo mkdir -p ~/.ros/log  && sudo chown -R $(whoami) /home/ws/ ~/.ros/ && sudo apt-get update && rosdep update && rosdep install --from-paths src --ignore-src -y"
}