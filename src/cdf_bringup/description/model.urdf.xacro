<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema" name="robot">
    <xacro:include filename="$(find cdf_bringup)/description/constants.xacro" />
    <xacro:include filename="$(find cdf_bringup)/description/inertia.xacro" />
    <xacro:include filename="$(find cdf_bringup)/description/materials.xacro" />
    <xacro:arg name="use_sim" default="true" />
    <xacro:if value="$(arg use_sim)">
        <xacro:include filename="$(find cdf_bringup)/description/gazebo_control.xacro" />
    </xacro:if>
    <xacro:unless value="$(arg use_sim)">
        <xacro:include filename="$(find cdf_bringup)/description/hardware_control.xacro" />
    </xacro:unless>
    <xacro:include filename="$(find cdf_bringup)/description/aruco.xacro" />

    <link name="base_link"></link>

    <!-- Chassis link (250 x 167 x 82 mm), centered at wheel axle height -->
    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis_link"/>
        <origin xyz="0 0 ${chassis_center_z}" rpy="0 0 0"/>
    </joint>

    <link name="chassis_link">
        <visual>
            <geometry>
                <box size="${chassis_link_x} ${chassis_link_y} ${chassis_link_z}" />
            </geometry>
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${chassis_link_x} ${chassis_link_y} ${chassis_link_z}" />
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_link_x}" y="${chassis_link_y}" z="${chassis_link_z}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>
    <gazebo reference="chassis_link">
        <material>Gazebo/Blue</material>
    </gazebo>

    <xacro:macro name="mecanum_wheel" params="prefix x y fdir">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel_link"/>
            <origin xyz="${x} ${y} ${wheel_axle_z}" rpy="${-pi/2} 0 0" />
            <axis xyz="0 0 1"/>
        </joint>

        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_link_diameter/2}" length="${wheel_link_length}"/>
                </geometry>
                <material name="orange"/>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${wheel_link_diameter/2}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_link_length}" radius="${wheel_link_diameter/2}">
                <origin xyz="0 0 0" rpy="0 0 0" />
            </xacro:inertial_cylinder>
        </link>
        <gazebo reference="${prefix}_wheel_link">
            <material>Gazebo/Orange</material>
            <collision>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.2</mu>
                            <mu2>0.0</mu2>
                            <fdir1 gz:expressed_in="base_link">${fdir}</fdir1>
                        </ode>
                    </friction>
                </surface>
            </collision>
        </gazebo>
    </xacro:macro>

    <xacro:mecanum_wheel prefix="front_left"  x="${ wheel_base_x/2}" y="${ wheel_track_y/2}" fdir="1 -1 0" />
    <xacro:mecanum_wheel prefix="front_right" x="${ wheel_base_x/2}" y="${-wheel_track_y/2}" fdir="1 1 0" />
    <xacro:mecanum_wheel prefix="rear_left"   x="${-wheel_base_x/2}" y="${ wheel_track_y/2}" fdir="1 1 0" />
    <xacro:mecanum_wheel prefix="rear_right"  x="${-wheel_base_x/2}" y="${-wheel_track_y/2}" fdir="1 -1 0" />

    <!-- Front suction cup: fixed, axis along +x. -->
    <joint name="front_suction_cup_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_suction_cup"/>
        <origin xyz="0.16 0 0.06" rpy="0 1.5708 0"/>
    </joint>

    <gazebo reference="front_suction_cup_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <link name="front_suction_cup">
        <visual>
            <geometry>
                <cylinder radius="0.015" length="0.02"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.015" length="0.02"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.01" length="0.02" radius="0.015">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="front_suction_cup">
        <material>Gazebo/Orange</material>
    </gazebo>

    <gazebo>
        <plugin filename="$(find cdf_vacuum_gripper)/../../lib/libcdf_vacuum_gripper.so"
                name="cdf_vacuum_gripper::VacuumGripper">
            <cup_link>front_suction_cup</cup_link>
            <service_name>/vacuum/front</service_name>
            <max_distance>0.25</max_distance>
            <lift>0.03</lift>
            <filter>stone_</filter>
        </plugin>
    </gazebo>
</robot>